# .env.example — MODÈLE des variables d'environnement (versionné dans Git).
# Copier ce fichier en ".env.local" (NON versionné) et remplir les valeurs.
# En production : les mêmes variables sont à saisir dans Cloudflare Pages
# (Settings > Variables and Secrets), puis redéployer.
#
# Toutes ces valeurs sont PUBLIQUES : préfixées NEXT_PUBLIC_, elles sont
# copiées dans le JavaScript du site au build. N'y mettez JAMAIS la clé
# privée EmailJS ni la clé secrète reCAPTCHA.

# EmailJS (tableau de bord EmailJS)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google reCAPTCHA v2 "case à cocher" : clé du SITE (la clé SECRÈTE va dans EmailJS)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=